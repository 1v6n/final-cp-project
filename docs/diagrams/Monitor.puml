@startuml
title Monitor - Flujo general de fireTransition()

autonumber
hide footbox

actor "Worker" as W
participant "Monitor" as M
participant "Ownership" as O
participant "entry\nSemaphore" as E
participant "RdP" as R
participant "TimeRestrictions" as T
participant "Policy" as P
participant "Queues\nsem[t]" as Q

note over O,E
  release() libera entry.
  handoff() transfiere la responsabilidad
  al waiter sin liberar entry.
end note

W -> M : fireTransition(t)
activate M
M -> M : validateTransitionIndex(t)
M -> O : new Ownership()

loop hasta disparar o set interrumpido
  opt !ownership.isOwned()
    M -> O : acquire()
    O -> E : acquire()
    O -> O : owned = true
  end

  M -> R : getSensitized()[t]
  R --> M : isSensitized

  alt transicion no sensibilizada
    group waitForSensitization(t)
      M -> Q : incrementWaitingCount(t)
      M -> O : release()
      O -> E : release()
      M -> Q : sem[t].acquire()
      Q --> M : signal
      M -> O : wakeFromQueue()
    end
    M -> M : continuar loop

  else transicion sensibilizada
    M -> T : evaluateFire(t)
    T --> M : FireEvaluation

    alt ALLOWED
      opt t es T6/T7 y ambas estan sensibilizadas
        M -> P : choose([T6, T7])
        P --> M : selected sticky
      end

      alt T6/T7 no es la seleccionada
        group volver a esperar el turno de politica
          M -> Q : incrementWaitingCount(t)
          M -> O : release()
          O -> E : release()
          M -> Q : sem[t].acquire()
          Q --> M : signal
          M -> O : wakeFromQueue()
        end
        M -> M : continuar loop

      else disparo permitido
        group fireAndReleaseTransition(t)
          M -> R : fireTransition(firingVector)
          R -> R : actualizar marcado y sensibilizacion
          M -> T : actualizar estado temporal posterior
          M -> M : logFireResult(t)\n(incluye P-invariantes)
          M -> P : onTransitionFired(t)\n(registrar y limpiar sticky)

          group seleccion post-disparo
            M -> R : getSensitized()
            M -> Q : getWaitingCounts()
            M -> M : wakingCandidates()

            opt politica activa y T6/T7 sensibilizadas
              M -> P : choose([T6, T7])
              P --> M : fijar/reusar seleccion sticky
            end

            alt no hay candidatos para despertar
              M -> O : release()
              O -> E : release()

            else hay candidatos
              alt politica deshabilitada
                M -> P : selectAny(candidates)
              else politica habilitada
                M -> P : choose(candidates)
              end
              P --> M : selectedTransition

              M -> Q : decrementWaitingCount(selectedTransition)
              M -> Q : sem[selectedTransition].release()
              M -> O : handoff()
              O -> O : owned = false

              ref over M,Q
                Detalle del traspaso entre hilos:
                MonitorHandoffSequence.puml
              end ref
            end
          end
        end

        break disparo completado
          M -> O : finally: release()\n(no-op despues de release/handoff)
          M --> W : true
        end
      end

    else TOO_EARLY
      group waitUntilEarliestFireTime(t)
        M -> T : getRemainingToEarliest(t)
        T --> M : remainingMs
        M -> O : release()
        O -> E : release()
        M -> M : sleep(remainingMs)
      end
      M -> M : continuar loop y readquirir entry

    else NOT_ENABLED
      M -> M : throw IllegalStateException
    end
  end
end

note over M,Q
  Si una espera es interrumpida, se compensa waitingCount.
  fireTransition() restaura la interrupcion, libera ownership
  si corresponde y retorna false.
end note

deactivate M
@enduml
