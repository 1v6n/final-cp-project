@startuml
title Monitor - Flujo general de fireTransition()

autonumber
hide footbox

actor "Worker" as W
participant "Monitor" as M
participant "Ownership" as O
participant "entry Semaphore" as E
participant "RdP" as R
participant "TimeRestrictions" as T
participant "Queues" as Q
participant "Policy" as P
participant "Invariants" as I
participant "LogService" as L

W -> M : fireTransition(t)
activate M
M -> M : validateTransitionIndex(t)
M -> O : new Ownership()

loop hasta disparar o ser interrumpido
  opt !ownership.isOwned()
    M -> O : acquire()
    O -> E : acquire()
    O -> O : owned = true
  end

  M -> R : isSensitized(t)
  R --> M : isSensitized

  alt transición no sensibilizada
    group waitForSensitization(t, ownership)
      M -> Q : incrementWaitingCount(t)
      M -> O : release()
      O -> E : release()
      M -> Q : sem[t].acquire()
      Q --> M : signal
      M -> O : wakeFromQueue()
    end
    M -> M : continuar loop con ownership heredado

  else transición sensibilizada
    M -> T : evaluateFire(t)
    T --> M : FireEvaluation

    alt TOO_EARLY
      group waitUntilEarliestFireTime(t, ownership)
        M -> O : release()
        O -> E : release()
        M -> T : awaitUntilEarliestFireTime(t)
        activate T
        T -> T : getRemainingToEarliest(t)
        T -> T : Thread.sleep(remainingMs)
        T --> M : tiempo alcanzado
        deactivate T
      end
      M -> M : continuar loop y readquirir entry

    else NOT_ENABLED
      M -> M : throw IllegalStateException

    else ALLOWED
      note over M,P
        ALLOWED no consulta la política.
        La política no autoriza ni difiere disparos.
      end note

      group fireAndReleaseTransition(t, ownership)
        M -> M : createFiringVector(t)
        M -> R : fireTransition(firingVector)
        R -> R : actualizar marcado y sensibilización

        M -> T : updateFromSensitized(R.getSensitized())
        M -> T : onTransitionFired(t, stillSensitized)
        M -> M : logFireResult(t)
        M -> I : checkPInvariants(R.getMarcadoActual())
        I --> M : resultados
        M -> L : logFire(..., snapshotMarking(), pinv)
        M -> P : onTransitionFired(t)

        group selectWaiterOrRelease(ownership)
          M -> M : wakingCandidates()
          loop para cada transición u
            M -> R : isSensitized(u)
            M -> Q : hasWaiters(u)
          end
          M <-- M : candidatos reales

          alt no hay candidatos
            M -> O : release()
            O -> E : release()

          else hay candidatos reales
            M -> P : choose(candidates)
            activate P
            P -> P : si hay conflicto real, obtener p
            P -> P : A' = A + p; elegir según carry de 100
            P -> P : guardar residuo y registrar decisión
            P --> M : selectedTransition
            deactivate P

            M -> M : signalOneWaiter(selectedTransition)
            M -> Q : signalOne(selectedTransition)
            M -> O : handoff()
            O -> O : owned = false
          end
        end
      end

      M -> M : return true
      break transición disparada
    end
  end
end

M -> O : finally: release()
note right of O
  No-op después de release() o handoff().
end note
M --> W : true / false si hubo interrupción
deactivate M

note over P,Q
  NONE elige aleatoriamente.
  BALANCED usa p = 50; PRIORITIZED usa p configurable.
  Ambos sólo aplican el acumulador de Bresenham
  si ambas transiciones del conflicto son candidatas reales.
end note

@enduml