@startuml
title Rediseño mínimo — Diagrama de clases

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 38
hide empty members

package "Aplicación" {
  interface Runnable <<interface>> {
    +run(): void
  }

  class Main {
    -{static} TOTAL_RUNS : int
    -{static} POLICY_MODE : PolicyMode

    +{static} main(args: String[]) : void
    -{static} createWorkers(monitor : Monitor, ...) : Thread[]
    -{static} startThreads(workers: Thread[]) : void
    -{static} awaitCompletion(running: AtomicBoolean, completed: AtomicInteger) : void
    -{static} stopThreads(running: AtomicBoolean, workers: Thread[]) : void
    -{static} joinThreads(workers: Thread[]) : void
    -{static} printSummary(startTime: long, completed: AtomicInteger, policy: Policy) : void
  }

  record "Main::WorkerSpec" as WorkerSpec {
    -name : String
    -path : List<Integer>
    -countsCompletion : boolean
  }

  class Threads implements Runnable {
    -path : List<Integer>
    -totalInvariants : int
    -monitor : MonitorInterface
    -completedInvariants : AtomicInteger
    -startedInvariants : AtomicInteger
    -countsCompletion : boolean
    -running : AtomicBoolean

    +Threads(path: List<Integer>, monitor: MonitorInterface, ...)
    +run() : void
  }
}

package "Monitor Concurrente" {
  interface MonitorInterface {
    +fireTransition(transition : int) : boolean
  }

  class Monitor implements MonitorInterface {
    -{static} TIMED_TRANSITIONS_BASE_MS : int[][]
    -entry : Semaphore
    -queues : Queues
    -rdp : RdP
    -policy : Policy
    -time : TimeRestrictions
    -log : LogService
    -pInvariants : List<Invariants.PInvariant>

    ~Monitor(rdp : RdP, log : LogService, policy : Policy)
    +fireTransition(transition : int) : boolean
    -waitForSensitization(transition : int, ownership : Ownership): void
    -fireAndReleaseTransition(transition : int, ownership : Ownership): void
    -selectWaiterOrRelease(ownership : Ownership): void
    -wakingCandidates(): List<Integer>
    -validateTransitionIndex(transition : int) : void
    -createFiringVector(transition : int) : DMatrixRMaj
    -catchMonitor() : void
    -releaseMonitor() : void
    -logFireResult(transition : int) : void
    -snapshotMarking() : int[]
  }

  class "Monitor::Ownership" as Ownership {
    -owned : boolean

    +acquire() : void
    +release() : void
    +handoff() : void
    +wakeFromQueue() : void
    +isOwned() : boolean
  }

  class "Monitor::Queues" as Queues {
    -queuesList : List<Semaphore>
    -numQueues : int
    -waitingCount : DMatrixRMaj
    
    ~Queues(numQueues : int)
    -initializeSemaphores() : void
    -createSemaphore() : Semaphore
    -incrementWaitingCount(transition : int) : void
    -decrementWaitingCount(transition : int) : void
    -hasWaiters(transition : int) : boolean
    -signalOne(transition : int): void
    -getSemaphoreForTransition(transition : int): Semaphore
  }
}

package "Red de Petri y Tiempo" {
  class RdP {
    -Incidencia : DMatrixRMaj
    -IncidenciaEntradaTraspuesta : DMatrixRMaj
    -MarcadoActual : DMatrixRMaj
    -Sensibilizadas : DMatrixRMaj
    -M0 : double[]
    -MatrixIncidencia : double[][]
    -MatrixIncidenciaEntradaTraspuesta : double[][]

    +RdP()
    +fireTransition(firingVector : DMatrixRMaj) : void
    +isSensitized(transition : int) : boolean
    -transicionesSensibilizadas() : void
    +getMarcadoActual() : DMatrixRMaj
    +getIncidencia() : DMatrixRMaj
    +getSensitized() : DMatrixRMaj
  }

  class TimeRestrictions {
    +{static} INFINITE_BETA : long
    -timedTransitions : Map<Integer, TimingConfig>
    -runtimeStates : Map<Integer, RuntimeState>
    -clockNs : LongSupplier

    ~TimeRestrictions(timedTransitionsConfig : int[][])
    +setTimedTransition(transition : int, alphaMs : long, betaMs : long) : void
    +isTimedTransition(transition : int) : boolean
    +updateSensitizationState(transition : int, isSensitized : boolean) : void
    +refreshTimedState(sensitized : DMatrixRMaj, firedTransition : int) : void
    +canFire(transition : int) : boolean
    +getRemainingToEFT(transition : int) : long
    ~awaitUntilEFT(transition : int) : void
  }

  class "TimeRestrictions::TimingConfig" as TimingConfig {
    -alphaNs : long
    -betaNs : long
  }

  class "TimeRestrictions::RuntimeState" as RuntimeState {
    -sensitized : boolean
    -enabledAtNs : long

    -RuntimeState()
  }
}

package "Política" {
  class Policy {
    -{static} BALANCED_PREFERRED_PERCENTAGE : int = 50
    -{static} AGENT_PREFERRED_PERCENTAGE : int = 75
    -{static} RESERVATION_PREFERRED_PERCENTAGE : int = 80
    -mode : PolicyMode
    -agentResidue : int
    -reservationResidue : int
    -agentInferiorCount : int
    -agentSuperiorCount : int
    -confirmedReservations : int
    -cancelledReservations : int
    -conflictAgentSuperior : int
    -conflictAgentInferior : int
    -conflictConfirmed : int
    -conflictCancelled : int

    +Policy(mode : PolicyMode)
    +recordFire(transition : int) : void
    -activeConflictIn(candidates : List<Integer>) : ConflictGroup
    +choose(candidates : List<Integer>) : int
    -selectAny(candidates : List<Integer>) : int
    -selectByPercentage(group : ConflictGroup) : int
    -getAccumulatedResidue(group : ConflictGroup) : int
    -getPreferredPercentage(group : ConflictGroup) : int
    -recordConflictDecision(selected : int) : void
    -recordRealFire(transition: int) : void
    +printSummary() : void
    -appendAgentSummary(summary : StringBuilder, total : int, conflictsTotal : int) : void
    -appendReservationSummary(summary : StringBuilder, total : int, conflictsTotal : int) : void
    -pct(part : int, total : int) : String
  }

  enum "Policy::PolicyMode" as PolicyMode {
    NONE
    BALANCED
    PRIORITIZED
  }

  enum "Policy::ConflictGroup" as ConflictGroup {
    AGENTS
    RESERVATIONS
    NONE
  }
}

package "Observabilidad" {
  interface AutoCloseable <<interface>> {
  +close(): void
  }

  class Invariants <<utility>> {
    +{static} defaultPInvariants() : List<PInvariant>
    +{static} checkPInvariants(marking : DMatrixRMaj, invariants : List<PInvariant>) : List<PInvariantResult>

    -Invariants()
  }

  class "Invariants::PInvariant" as PInvariant {
    -name : String
    -places : int[]
    -expected : int

    +PInvariant(name : String, places : int[], expected : int)
  }
  record "Invariants::PInvariantResult" as PInvariantResult

  class LogService implements AutoCloseable {
    -writer : BufferedWriter
    -tsFmt : DateTimeFormatter

    +LogService(logPath : Path)
    +synchronized logFire(threadName : String, transition : int, ok : boolean, marking : int[], pinv : String) : void
    +synchronized logEvent(threadName : String, event: String) : void
    -writeLine(line : String) : void
    -formatMarking(m : int[]) : String
    +synchronized close() : void
  }

  class ProgressBar implements AutoCloseable {
    -total : int
    -completed : AtomicInteger
    -barWidth : int
    -out : PrintStream
    -lastPercent : int
    -completed_printed : boolean

    +ProgressBar(total : int, completed : AtomicInteger, barWidth : int)
    +synchronized update() : void
    -render(current : int, percent : int) : void
    +close() : void
  }
}

Threads --> MonitorInterface

Main +-- WorkerSpec
Main ..> Threads
Main ..> ProgressBar
Main ..> Monitor
Main ..> RdP
Main ..> Policy
Main ..> LogService

Monitor --> RdP
Monitor --> Policy
Monitor *-- TimeRestrictions
Monitor *-- Queues
Monitor *-- Ownership
Monitor --> LogService
Monitor --> PInvariant
Monitor ..> Invariants

TimeRestrictions *-- TimingConfig
TimeRestrictions *-- RuntimeState
Policy --> PolicyMode
Policy ..> ConflictGroup
Invariants +-- PInvariant
Invariants +-- PInvariantResult

note right of WorkerSpec
  Se conserva el record existente.
  La configuración final usa una responsabilidad por worker.
end note

note right of Policy
  choose() recibe exclusivamente candidatos reales:
  transición sensibilizada + waiter existente.

  NONE: aleatorio.
  BALANCED: porcentaje preferido = 50.
  PRIORITIZED: usa el porcentaje configurable del grupo.

  selectByPercentage() implementa Bresenham:
  A' = A + p
  si A' >= 100: elige preferida y guarda A' - 100
  si A' < 100: elige alternativa y guarda A'

  choose() resuelve el grupo y el porcentaje
  directamente; no hay helpers de mapeo por
  transición, residuo o patrón.

  selectByPercentage() registra la decisión de
  conflicto. Los contadores se conservan para
  printSummary().

  recordFire() sólo registra disparos globales.
  No hay campos ni decisiones sticky.

  activeConflictIn() conserva el orden actual:
  AGENTS antes que RESERVATIONS.
  Monitor nunca necesita consultar isEnabled().
end note

note bottom of Policy
  Después de n conflictos reales del mismo grupo:

  n * p = 100 * S_n + A_n, con 0 <= A_n < 100

  y_ideal = n * p / 100
  y_real  = S_n
  error pendiente = A_n / 100

  Por lo tanto: y_ideal = y_real + error pendiente.
end note

note bottom of Monitor
  Se conservan los helpers y las clases internas.
  Se eliminan dos desvíos del flujo principal:
  handleSensitizedTransition() y
  shouldDeferToPolicySelectedReservation().

  fireTransition() usa un if/else sobre canFire():
  verdadero dispara, falso libera ownership y
  delega la espera temporal a awaitUntilEFT().

  wakingCandidates() consulta RdP.isSensitized(t)
  y Queues.hasWaiters(t), sin exponer matrices
  ni semáforos al flujo de selección.
end note

note bottom of TimeRestrictions
  El Monitor delega la espera temporal en
  awaitUntilEFT(), que duerme en intervalos de
  getRemainingToEFT() ms hasta alcanzar la EFT.
  canFire() devuelve boolean y lanza
  IllegalStateException si la LFT expiró.
end note

@enduml
